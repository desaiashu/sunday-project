sig
  bpm 130
  system 12tet western
  scale C chromatic

arr
  main 32 |opa

tracks
  1 Audio |wsd
    type audio
    strip tivraStrip
  2 MIDI |tdh
    type midi
    plugin tivraWavetable
    fx tivraVibeFX
    strip tivraStrip

returns
  0 Hall |rii
    fx tivraHall
    strip tivraStrip
  1 Plate |rrv
    fx tivraPlate
    strip tivraStrip
  2 Delay |rac
    fx tivraDelay
    strip tivraStrip
  3 Color |ruj
    fx tivraDistortion
    strip tivraStrip

master
  strip tivraMastering

sec main
  trk 1 Audio |wsd
    c 4:66 34:256 |mice
      'samples/Chicago sketch 10-Mini V3.wav'
    auto volume
      . 0:0 0:230 2:326
      _ 0.9976 0.5211 0.7211
      ~ exp exp lin
  trk 2 MIDI |tdh
    c 2:0 2:0 |rxyj
      p _q _x _s s _q _x _s s _xx s _xxd _s s _xx _s s _h _xx _s
        v 100
        n F3 D#3 C#3 C#3 D3
